<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet solo para los videos con recompensa (AdMob). El juego y su tipografía van completos
         dentro de la app y se pueden jugar sin conexión (sin videos). El SDK de anuncios agrega además
         ACCESS_NETWORK_STATE y el permiso del ID de publicidad (AD_ID). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- AdMob: los IDs se configuran en gradle.properties (los builds debug usan siempre los de prueba) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <meta-data
            android:name="com.newplayerone.towrix.ADMOB_REWARDED_ID"
            android:value="${admobRewardedId}" />

        <!-- TOWRIX se juega en vertical y en horizontal (la batalla se ve más grande en horizontal).
             configChanges evita que el juego se reinicie al girar el celular. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
